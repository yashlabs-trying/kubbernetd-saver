#!/usr/bin/expect -f
spawn ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=30 0qw9b16v1svd6g-64410d07@ssh.runpod.io -i ~/.ssh/id_ed25519 "nvidia-smi --query-gpu=index,name,memory.total,memory.free,utilization.gpu --format=csv,noheader 2>&1; docker --version 2>&1; kubectl version --client 2>&1; python3 --version 2>&1; free -h 2>&1; nproc 2>&1; echo '===DONE==='"
expect {
    "Are you sure" { send "yes\r"; exp_continue }
    "===DONE===" { puts $expect_out(buffer); exit 0 }
    timeout { puts "TIMEOUT"; exit 1 }
    eof { puts "EOF"; exit 0 }
}